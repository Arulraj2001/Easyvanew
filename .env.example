# =========================================================================
# EASYVA STORE CONFIGURATION
# =========================================================================

# Local Site URL (change to your production domain on Cloudflare)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -------------------------------------------------------------------------
# SUPABASE BACKEND (Dual-mode: Works locally, syncs when credentials entered)
# -------------------------------------------------------------------------
# 1. Create a free project at https://supabase.com
# 2. In your Supabase SQL Editor, run the script: supabase/schema.sql
# 3. Paste your project URL and Anon key below:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin Whitelist (comma-separated emails) & Master Passkey
NEXT_PUBLIC_ADMIN_EMAILS=admin@yourdomain.com,staff@yourdomain.com
NEXT_PUBLIC_ADMIN_PASSKEY=YourSecretPasskeyHere

